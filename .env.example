# Public site configuration (all optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.invalid
NEXT_PUBLIC_SECURITY_EMAIL=security@example.invalid
# Where "Sign in" hands visitors over to the community web app (leave empty if not deployed)
NEXT_PUBLIC_APP_URL=
# Store badges render only when set; otherwise "Ask us for early access" is shown
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=
# /get-started posts JSON here; if empty the request is only kept in the visitor's browser
NEXT_PUBLIC_LEAD_ENDPOINT=
