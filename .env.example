# Data mode: "mock" (default; fully offline in-browser backend) or "live" (real backend through the BFF)
NEXT_PUBLIC_DATA_MODE=mock

# Public site config (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=
NEXT_PUBLIC_LEAD_ENDPOINT=
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.invalid
NEXT_PUBLIC_SECURITY_EMAIL=security@example.invalid

# Live mode only (server-side; never exposed to the browser)
VM_API_BASE_URL=https://public-vertical-host.example
KEYCLOAK_ISSUER=https://keycloak.example/auth/realms/vertical-realm
KEYCLOAK_CLIENT_ID=vibemind-web
KEYCLOAK_CLIENT_SECRET=
SESSION_SECRET=change-me-to-32-plus-random-bytes-before-use
APP_ORIGIN=http://localhost:3000
